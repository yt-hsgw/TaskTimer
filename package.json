{
  "name": "tasktimer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yt-hsgw/TaskTimer.git"
  },
  "bugs": {
    "url": "https://github.com/yt-hsgw/TaskTimer/issues"
  },
  "homepage": "https://github.com/yt-hsgw/TaskTimer#readme",
  "type": "module",
  "workspaces": [
    "tools/api-docs"
  ],
  "scripts": {
    "dev": "vite",
    "docs": "npm run docs:typescript && npm run docs:rust",
    "docs:typescript": "npm run docs --workspace @tasktimer/api-docs-toolchain",
    "docs:rust": "cargo doc --manifest-path src-tauri/Cargo.toml --no-deps --document-private-items",
    "build": "tsc --noEmit && vite build",
    "audit:runtime-privacy": "node scripts/audit-runtime-privacy.mjs",
    "check:glib-advisory": "node scripts/check-glib-advisory.mjs",
    "check:release-platform-policy": "node scripts/check-release-platform-policy.mjs",
    "check:release-target": "node scripts/check-release-target.mjs",
    "perf:measure": "cargo run --manifest-path src-tauri/Cargo.toml --bin measure_large_dataset --",
    "perf:seed": "cargo run --manifest-path src-tauri/Cargo.toml --bin seed_large_dataset --",
    "perf:ui": "node scripts/measure-large-ui.mjs",
    "preview": "vite preview",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
